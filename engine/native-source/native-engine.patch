 		}
 	}
 
+	// Remote player proxies are deliberately excluded from several stock ped
+	// queries because they are network-driven. Still resolve their contact at
+	// the original FightStrike animation window, using the same animated
+	// collision spheres and FightHitPed path as every local civilian.
+	for(int slot = 0; slot < 7; slot++) {
+		if(m_fightState == FIGHTSTATE_JUST_ATTACKED)
+			break;
+		nearPed = ViceTogetherRemotePed(slot);
+		if(!nearPed || nearPed == this || nearPed->bInVehicle || !nearPed->bUsesCollision)
+			continue;
+
+		if(!fightWithWeapon && GetWeapon()->m_eWeaponType != WEAPONTYPE_UNARMED && GetWeapon()->m_eWeaponType != WEAPONTYPE_BRASSKNUCKLE)
+			maxDistanceToBeat = nearPed->GetBoundRadius() + radius + 0.1f;
+		else
+			maxDistanceToBeat = nearPed->GetBoundRadius() + radius;
+		hisCol = ((CPedModelInfo*)CModelInfo::GetModelInfo(nearPed->GetModelIndex()))->AnimatePedColModelSkinnedWorld(nearPed->GetClump());
+		if(!hisCol)
+			continue;
+		CVector nearPedCentre = nearPed->GetBoundCentre();
+		if(sq(maxDistanceToBeat) <= (nearPedCentre - touchedNodePos).MagnitudeSqr())
+			continue;
+
+		bool pedFound = false;
+		for(int j = 0; j < hisCol->numSpheres; j++) {
+			attackDistance = hisCol->spheres[j].center - touchedNodePos;
+			if(sq(hisCol->spheres[j].radius + radius) > attackDistance.MagnitudeSqr()) {
+				FightHitPed(nearPed, touchedNodePos, attackDistance, hisCol->spheres[j].piece);
+				pedFound = true;
+				break;
+			}
+		}
+
+		// Preserve the stock extended reach used by fist moves whose hand
+		// animation passes just short of the target's animated collision hull.
+		if(!pedFound && !fightWithWeapon) {
+			extendedTouchPoint = touchedNodePos - GetPosition();
+			if(DotProduct(touchedNodePos - GetPosition(), nearPed->GetPosition() - GetPosition()) > 0.f) {
+				if(m_curFightMove == FIGHTMOVE_GROUNDKICK)
+					extendedTouchPoint += tFightMoves[FIGHTMOVE_GROUNDKICK].extendReachMultiplier * GetForward();
+				else {
+					extendedTouchPoint.x *= tFightMoves[m_curFightMove].extendReachMultiplier;
+					extendedTouchPoint.y *= tFightMoves[m_curFightMove].extendReachMultiplier;
+				}
+				extendedTouchPoint += GetPosition();
+				if(sq(maxDistanceToBeat) > (nearPedCentre - extendedTouchPoint).MagnitudeSqr()) {
+					for(int j = 0; j < hisCol->numSpheres; j++) {
+						attackDistance = hisCol->spheres[j].center - extendedTouchPoint;
+						if(sq(hisCol->spheres[j].radius + tFightMoves[m_curFightMove].strikeRadius) > attackDistance.MagnitudeSqr()) {
+							FightHitPed(nearPed, extendedTouchPoint, attackDistance, hisCol->spheres[j].piece);
+							break;
+						}
+					}
+			}
+		}
+		// Network proxies can arrive a few centimetres away from the skinned
+		// collision pose between snapshots. If the stock strike is in its real
+		// contact window, allow the same stock hit response when Tommy is close,
+		// facing the proxy, and no world geometry blocks the short reach.
+		if(!fightWithWeapon && m_fightState != FIGHTSTATE_JUST_ATTACKED) {
+			CVector targetCentre = nearPed->GetBoundCentre();
+			CVector toTarget = nearPed->GetPosition() - GetPosition();
+			const float distance = toTarget.Magnitude2D();
+			const float facing = distance > 0.001f ? DotProduct(GetForward(), toTarget) / distance : 0.0f;
+			if(distance <= 1.45f && facing > 0.25f) {
+				CColPoint obstructionPoint = {};
+				CEntity* obstruction = nil;
+				CEntity* oldIgnore = CWorld::pIgnoreEntity;
+				CWorld::pIgnoreEntity = this;
+				const bool blocked = CWorld::ProcessLineOfSight(GetPosition() + CVector(0.0f, 0.0f, 0.8f), targetCentre, obstructionPoint, obstruction, true, true, false, true, true, false);
+				CWorld::pIgnoreEntity = oldIgnore;
+				if(!blocked || !obstruction || obstruction == nearPed || (obstructionPoint.point - GetPosition()).MagnitudeSqr() >= (targetCentre - GetPosition()).MagnitudeSqr()) {
+					CVector direction = targetCentre - touchedNodePos;
+					FightHitPed(nearPed, targetCentre, direction, PEDPIECE_TORSO);
+				}
+			}
+		}
+	}
+	}
+
 
 	if (m_fightState == FIGHTSTATE_NO_MOVE)
 		m_fightState = FIGHTSTATE_1;
